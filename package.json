{
  "name": "pi-webfetch",
  "version": "0.1.0",
  "description": "Fetch web pages as markdown, text, or HTML from pi",
  "keywords": [
    "pi",
    "pi-package",
    "webfetch"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "type": "module",
